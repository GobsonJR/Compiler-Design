[a-zA-Z][a-zA-Z0-9&@$\-]* {
   int len = strlen(yytext);
   int l=1,upper=0,lower=0,digit=0,special=0;
   if(len<8) {
      printf("Invalid password:length less than 8\n");
      l=0;
   }
   if(len>64){
      printf("invalid password:length greater than 64\n");
      l=0;
   }
   for(i=0;i<len;i++){
      if(isupper(yytext[i])) upper=1;
      if(islower(yytext[i])) lower=1;
      if(isdigit(yytext[i])) digit=1;
      if(yytext[i]=='$'||yytext[i]=='@'||yytext[i]=='&'||yytext[i]=='_') special=1;
   }
   if(!upper)
   printf("error:no uppercase\n");
   if(!lower)
   printf("error:no lowercase\n");
   if(!digit)
   printf("error:no digit\n");
   if(!special)
   printf("error:no special character\n");
   if(upper && lower && l && digit && special)
   printf("valid password\n");
   return 0;
}
[^\n]+ {
   printf("invalid password:should start with an alphabet and contain only valid charcters.\n");
   return 0;
}
