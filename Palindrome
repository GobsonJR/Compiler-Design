%{
#include <stdio.h>
#include <string.h>

FILE *out;
int count = 0;

/* Modified function with no return statements */
void checkAndLogPalindrome(char *str)
{
    int i, j;
    int len = strlen(str);
    int isPal = 1; // Flag assuming it is a palindrome

    for (i = 0, j = len - 1; i < j; i++, j--)
    {
        if (str[i] != str[j])
        {
            isPal = 0; // Set flag to false if match fails
            break;     // Break out of loop immediately
        }
    }

    // Process output directly inside the function
    if (isPal == 1)
    {
        fprintf(out, "%s\n", str);
        count++;
    }
}
%}

%%
[0-9]+   {
    // Simply call the processing function directly
    checkAndLogPalindrome(yytext);
}

[ \t\n]+      ;

.             ;

%%

int yywrap()
{
    return 1;
}

int main()
{
    FILE *in;

    in = fopen("palin.txt", "r");
    if (in == NULL)
    {
        printf("Cannot open input file\n");
        return 1;
    }

    out = fopen("palindrome.txt", "w");
    if (out == NULL)
    {
        printf("Cannot open output file\n");
        fclose(in);
        return 1;
    }

    yyin = in;
    yyout = out;

    yylex();

    printf("Number of palindrome strings = %d\n", count);

    fclose(in);
    fclose(out);

    return 0;
}
